// GRID BASE MOVEMENT
// Attach this to a character GameObject. Good for roguelikes, puzzle games, tactics games.
// The character snaps to whole tile positions rather than moving continously 
// CODE PROPER 

using UnityEngine;

public class GridMovement : MonoBehaviour 
{
    public float tileSize =1.0f; // size of one grid cell
    public movementSpeed =10f; // how fast your character glide between tiles ( feel, not logic)

    private Vector3 targetPositions;
    private bool isMoving = false;

    void Start()
    {
     // Snap starting position to the grid so everything lines up 
        targetPosition = SnapToGrid (transform.position); 
        transform.position = targetPosition;

    }
    void Update()
    {
        if (!isMoving)
        {
            HandleInput();
        }
        else 
        {
            // Smoothly glide to the next line(this is presentation, not the actual logic)
            transform.position = Vector3.MoveTowards(transform.position,targetPosition,moveSpeed * TimedeltaTime);
            if(Vector3.Distance(transform.poistion,targetPosition)<0.001f)
            {
                transform.position = targetPosition;
